<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="auto">

    <!-- 1. Single Rotating Camera Link on Top of Chassis -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.02 0.05 0.03"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.05 0.03"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.02"/>
            <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
        </inertial>
    </link>

    <!-- 2. Continuous Roof Turret Joint -->
    <joint name="camera_joint" type="continuous">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <!-- Mounted on top roof (z = 0.20m) for unobstructed 360-degree view -->
        <origin xyz="0.15 0 0.20" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- 3. Standard ROS Optical Frame (+Z forward, +X right, +Y down) -->
    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
    </joint>

    <link name="camera_link_optical"/>

    <!-- 4. Single RGB-D Depth Sensor -->
    <gazebo reference="camera_link">
        <sensor name="camera" type="rgbd_camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>8</update_rate>
            <topic>camera</topic>
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>320</width>
                    <height>240</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.35</near>
                    <far>8.0</far>
                </clip>
                <optical_frame_id>camera_link_optical</optical_frame_id>
            </camera>
        </sensor>
    </gazebo>

    <!-- 5. Commandable Camera Rotation Motor + Joint State Publisher -->
    <gazebo>
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
            <joint_name>camera_joint</joint_name>
            <initial_velocity>0.0</initial_velocity>
            <topic>/camera_joint/cmd_vel</topic>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <joint_name>camera_joint</joint_name>
        </plugin>
    </gazebo>

</robot>