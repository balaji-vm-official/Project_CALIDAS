<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="track">
    
    <!-- Physics Settings -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic World Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_type>ogre2</render_type>
    </plugin>

    <!-- Sun Light with Shadows Enabled -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="textured_surface">
      <static>true</static>
      <pose>-2.5 18 0.05 0 0 -1.6</pose>
      <link name="textured_link">

        <visual name="surface_visual">
          <geometry>
            <box>
              <size>40.0 40.0 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
            <pbr>
              <metal>
                <!-- Path to your texture file -->
                <albedo_map>file:///home/comrade/Documents/Project_CALIDAS/src/Project_CALIDAS/src/track.png</albedo_map>
                <roughness>0.8</roughness>
                <metalness>0.1</metalness>
              </metal>
            </pbr>
          </material>
        </visual>

        <collision name='collision'>
          <geometry>
            <box>
              <size>40.0 40.0 0.001</size>
            </box>
          </geometry>
        </collision>

      </link>
    </model>

  </world>
</sdf>
