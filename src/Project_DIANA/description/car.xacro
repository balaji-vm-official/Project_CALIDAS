<?xml version='1.0'?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertia.xacro"/>

    <!-- Colours -->


        <material name="white">
            <color rgba="1 1 1 1"/>
        </material>
        <material name="orange">
            <color rgba="1 0.3 0.1 1"/>
        </material>
        <material name="blue">
            <color rgba="0.2 0.2 1 1"/>
        </material>
        <material name="black">
            <color rgba="0 0 0 1"/>
        </material>
        <material name="red">
            <color rgba="1 0 0 1"/>
        </material>


    <!-- Links & Joints -->
        

        <link name="base_link"></link>

        <link name="chassis">
            <visual>
                <origin xyz="0.35 0 0.12"/>
                <geometry>
                    <box size="0.7 0.3 0.15"/>
                </geometry>
                <material name="red"/>
            </visual>
            <collision>
                <origin xyz="0.15 0 0.075"/>
                <geometry>
                    <box size="0.4 0.3 0.15"/>
                </geometry>
                <material name="white"/>
            </collision>
            <xacro:inertial_box mass="1" x="0.3" y="0.3" z="0.15">
                <origin xyz="0.15 0 0.075" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>
        <joint name="chassis_joint" type="fixed">
            <parent link="base_link"/>
            <child link="chassis"/>
            <origin xyz="0 0 0"/>
        </joint>

        <link name="nose">
            <visual>
                <origin xyz="0.9 0 0.075"/>
                <geometry>
                    <box size="0.5 0.1 -0.05"/>
                </geometry>
                <material name="red"/>
            </visual>
            <collision>
                <origin xyz="0.4 0 0.075"/>
                <geometry>
                    <box size="0.5 0.1 -0.05"/>
                </geometry>
                <material name="white"/>
            </collision>
            <xacro:inertial_box mass="1" x="0.5" y="0.1" z="0.05">
                <origin xyz="0.4 0 0.08" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>
        <joint name="nose_joint" type="fixed">
            <parent link="base_link"/>
            <child link="nose"/>
            <origin xyz="0 0 0"/>
        </joint>

        <link name="front_rod">
            <visual>
                <geometry>
                    <cylinder radius="0.0067" length="0.3"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.076" length="0.06"/>
                </geometry>
                <material name="black"/>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <joint name="front_rod" type="continuous">
            <parent link="base_link"/>
            <child link="front_rod"/>
            <origin xyz="0.96 0 0.08" rpy="-${pi/2} 0 0"/>
            <axis xyz = "0 0 1"/>
        </joint>

        <link name="front_left_wheel">
            <visual>
                <geometry>
                    <cylinder radius="0.094" length="0.07"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.094" length="0.07"/>
                </geometry>
                <material name="black"/>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <joint name="front_left_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="front_left_wheel"/>
            <origin xyz="0.96 0.178 0.08" rpy="-${pi/2} 0 0"/>
            <axis xyz = "0 0 1"/>
        </joint>

        <link name="front_right_wheel">
            <visual>
                <geometry>
                    <cylinder radius="0.094" length="0.07"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.076" length="0.07"/>
                </geometry>
                <material name="black"/>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <joint name="front_right_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="front_right_wheel"/>
            <origin xyz="0.96 -0.178 0.08" rpy="${pi/2} 0 0"/>
            <axis xyz = "0 0 -1"/>
        </joint>

        <link name="back_left_wheel">
            <visual>
                <geometry>
                    <cylinder radius="0.094" length="0.08"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.08" length="0.07"/>
                </geometry>
                <material name="black"/>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <joint name="back_left_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="back_left_wheel"/>
            <origin xyz="0.2 0.18 0.08" rpy="-${pi/2} 0 0"/>
            <axis xyz = "0 0 1"/>
        </joint>

        <link name="back_right_wheel">
            <visual>
                <geometry>
                    <cylinder radius="0.094" length="0.08"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.08" length="0.07"/>
                </geometry>
                <material name="black"/>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <joint name="back_right_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="back_right_wheel"/>
            <origin xyz="0.2 -0.18 0.08" rpy="${pi/2} 0 0"/>
            <axis xyz = "0 0 -1"/>
        </joint>


    <!-- Gazebo Parameters -->

        <gazebo reference="body_link">
            <mu1>0.0001</mu1>
            <mu2>0.0001</mu2>
        </gazebo>

        <gazebo reference="front_right_wheel_link">
            <mu1>100.0</mu1>
            <mu2>100.0</mu2>
        </gazebo>

        <gazebo reference="front_left_wheel_link">
            <mu1>100.0</mu1>
            <mu2>100.0</mu2>
        </gazebo>
            
        <gazebo reference="rear_right_wheel_link">
            <mu1>100.0</mu1>
            <mu2>100.0</mu2>
        </gazebo>

        <gazebo reference="rear_left_wheel_link">
            <mu1>100.0</mu1>
            <mu2>100.0</mu2>
        </gazebo>

</robot>